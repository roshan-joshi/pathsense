{
  "name": "pathsense-home-presentation",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "serve:offline": "node scripts/serve-offline.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "narration": "node scripts/generate-narration.mjs",
    "images": "python3 scripts/prepare-images.py",
    "export:offline": "node scripts/export-offline.mjs",
    "export:pdf": "node scripts/export-pdf.mjs",
    "export:stills": "node scripts/export-stills.mjs",
    "export:pptx": "node scripts/export-pptx.mjs",
    "export:video": "node scripts/export-video.mjs",
    "build:pages": "VITE_BASE=/pathsense/ vite build --outDir dist-pages",
    "test:pages": "npm run build:pages && playwright test -c playwright.pages.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.1.0",
    "@fontsource-variable/inter": "^5.1.0",
    "gsap": "^3.12.5",
    "kokoro-js": "^1.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.52.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "pptxgenjs": "^3.12.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
